# 复制为 .env 后由 docker compose 注入容器（.env 已被 .gitignore 忽略）。
# 所有项都是可选的：Provider 页配置的模型服务把地址与密钥存在 backend/data/providers/，不走这里。

# 走宿主机代理访问云端模型时（容器里 localhost 不是宿主机）
#HTTP_PROXY=http://host.docker.internal:7890
#HTTPS_PROXY=http://host.docker.internal:7890
#NO_PROXY=localhost,127.0.0.1,host.docker.internal

# 不用 Provider 页、直接按 litellm 环境变量鉴权时（档案 model 写 provider/model 前缀）
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_REGION_NAME=us-east-1

# 本地 Ollama（默认已指向宿主机）
#OLLAMA_API_BASE=http://host.docker.internal:11434

# 自定义技能目录（容器内路径；需另行挂载）
#AGENTHOWL_SKILLS_DIR=/app/backend/skills

# 历史对局公开回放（默认 1）：已结束对局无需 token 即可列出与回放；多用户场景设为 0
#AGENTHOWL_PUBLIC_HISTORY=1

# 发言配音（issue #103）：OpenAI /v1/audio/speech 兼容服务；空 = 关闭。本机 `make tts` 起 mlx-audio 后：
#AGENTHOWL_TTS_URL=http://host.docker.internal:8880
#AGENTHOWL_TTS_KIND=mlx_audio          # mlx_audio | openai | generic
#AGENTHOWL_TTS_MODEL_PRESET=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-6bit
#AGENTHOWL_TTS_MODEL_DESIGN=mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-6bit
#AGENTHOWL_TTS_API_KEY=                # 仅 openai 类服务需要
